# Everything here is OPTIONAL. With no keys the site runs on config data alone
# (Home + About). Add keys only for the integrations you turn on in
# portfolio.config.ts -> integrations.

# --- GitHub (integrations.github) -------------------------------------------
# Optional. Raises the GitHub API rate limit for live project/activity data.
# The integration also works without a token at a lower anonymous limit.
GITHUB_TOKEN=

# --- AI: Ask page + commit-to-news changelog (integrations.ai) --------------
# Set the one matching integrations.ai.provider.
# Default provider is "gemini" — free key from https://aistudio.google.com/apikey
GEMINI_API_KEY=
OPENAI_API_KEY=
ANTHROPIC_API_KEY=

# --- Supabase snapshot cache (integrations.supabase) ------------------------
# Optional read-through cache so pages don't hit the GitHub API on every request.
# Apply docs/supabase-schema.sql first.
NEXT_PUBLIC_SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

# Shared secret protecting the /api/cron/sync endpoint (Vercel Cron).
CRON_SECRET=
